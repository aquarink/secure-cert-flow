# ==============================================================================
# SECURE CERT FLOW - CONFIGURATION TEMPLATE (.env.example)
# DO NOT PUT REAL CREDENTIALS IN THIS FILE. COPY TO .env AND UPDATE ACCORDINGLY.
# ==============================================================================

# Application Environment & Server Settings
APP_NAME=SecureCertFlow
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
APP_BASE_URL=http://localhost:8000

# Security & JWT Token Authentication
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_HOST=10.88.0.7
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password_here
POSTGRES_DB=sertifikat_db
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# MinIO / S3 Object Storage Configuration
MINIO_ENDPOINT=10.88.0.11:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_TEMPLATES=cert-templates
MINIO_BUCKET_CERTIFICATES=cert-outputs
MINIO_BUCKET_SIGNATURES=cert-signatures

# Apache Kafka Message Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=10.88.0.7:9092
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=admin
KAFKA_SASL_PASSWORD=your_kafka_password_here
KAFKA_TOPIC_CERT_GENERATION=cert_generation_queue
KAFKA_CONSUMER_GROUP=cert_generation_workers

# CI/CD Webhook Configuration
WEBHOOK_SECRET=your_github_webhook_secret_key
